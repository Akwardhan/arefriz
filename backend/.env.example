# Server Configuration
PORT=5001
NODE_ENV=development

# Database (PostgreSQL / Prisma)
DATABASE_URL=postgresql://arefriz_admin:arefriz_secure_password@localhost:5432/arefriz_db

# Legacy Database (MongoDB - during transition)
MONGO_URI=mongodb://localhost:27017/arefriz

# Redis (Rate Limiting, Caching, BullMQ Queues)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
CORS_ORIGIN=http://localhost:3000

# Email Services
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=orders@arefriz.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
